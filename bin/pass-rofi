#!/usr/bin/env fish
# Launches the pass-rofi rofi script mode, matching GNOME's color scheme.

set -l here (dirname (status filename))
set -l script $here/pass-rofi-script

# Editable pip installs don't put the source tree on the subprocess path;
# point the backend at it when the package isn't importable.
if not set -q PASS_ROFI_SRC; and not python3 -c "import pass_rofi" 2>/dev/null
    if test -d $here/../src/pass_rofi
        set -x PASS_ROFI_SRC (realpath $here/../src)
    end
end

set scheme (dconf read /org/gnome/desktop/interface/color-scheme 2>/dev/null | string trim)

switch $scheme
    case "'prefer-dark'"
        set theme Dark
    case '*'
        set theme Arc
end

set -l args -normal-window -kb-custom-1 Ctrl+l -kb-mode-complete "" -modi "pass:$script" -show pass -theme-str "window { width: 720px; }"

if test -f /home/linuxbrew/.linuxbrew/share/rofi/themes/$theme.rasi
    exec rofi $args -theme $theme
else
    exec rofi $args
end
